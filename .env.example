# Notion API Configuration
# Get your token from: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_database_id_here

# Instagram API Configuration
# 1. Convertir votre compte en Business/Creator (gratuit)
# 2. Créer une app Facebook : https://developers.facebook.com
# 3. Générer un token longue durée via l'API Graph
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
# Hashtags à rechercher dans vos posts (séparés par des virgules)
INSTAGRAM_HASHTAGS=tokyo,architecture,streetart
# Nombre max de posts à récupérer (défaut: 100)
INSTAGRAM_LIMIT=100
