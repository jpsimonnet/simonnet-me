---
permalink: false
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Oxymore</title>
  <meta name="description" content="{{ description or 'Jean-Philippe Simonnet — expert accessibilité numérique.' }}">
  <link rel="stylesheet" href="/css/refonte.css">
  <link rel="stylesheet" href="/css/print.css" media="print">
  <link rel="icon" href="/favicon.ico">
</head>
<body>
  <a class="skip-link" href="#nav-main">Aller au menu</a>
  <a class="skip-link" href="#main">Aller au contenu</a>
  <a class="skip-link" href="#search-panel">Aller à la recherche</a>
  <a class="skip-link" href="#footer">Aller au pied de page</a>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-logo" href="/" aria-label="Oxymore — accueil">
        <svg class="logo_oxymore" role="img" aria-label="Oxymore — un silence assourdissant"
             viewBox="0 0 598 220" xmlns="http://www.w3.org/2000/svg"
             style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;">
          <g transform="matrix(1,0,0,1,-17,10)">
            <g transform="matrix(1,0,0,1,-136.127,-86.0034)">
              <path class="logo-swoosh" d="M191,213.128C191,213.128 337.945,158.83 430.99,213C542.829,278.112 681.235,212 681.235,212C681.235,212 574.259,317.376 423,247.251C333.393,205.709 191,213.128 191,213.128Z"/>
            </g>
            <g transform="matrix(1,0,0,1,12,135)">
              <text class="logo-title" x="0" y="0"
                    style="font-family:'Playfair Display','Didot',serif;font-weight:700;font-size:136.813px;">Oxymore</text>
            </g>
            <g transform="matrix(1.35,0,0,1.30,115,50)">
              <text class="logo-subtitle" x="0" y="0"
                    style="font-family:'Playfair Display','Didot',serif;font-weight:400;font-size:34px;font-style:italic;">un silence assourdissant</text>
            </g>
          </g>
        </svg>
      </a>

      <button class="menu-toggle" aria-expanded="false" aria-controls="nav-main" aria-label="Menu">
        <svg class="icon-open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="icon-close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <nav class="site-nav" id="nav-main" aria-label="Navigation principale">
        <ul>
          <li><a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Accueil</a></li>
          <li><a href="/qui-suis-je/" {% if page.url == '/qui-suis-je/' %}aria-current="page"{% endif %}>À propos</a></li>
          <li><a href="/a-la-une/" {% if '/a-la-une' in page.url %}aria-current="page"{% endif %}>À la une</a></li>
          <li><a href="/lectures/" {% if '/lectures' in page.url %}aria-current="page"{% endif %}>Lectures</a></li>
          <li><a href="/interventions/" {% if '/intervention' in page.url %}aria-current="page"{% endif %}>Interventions</a></li>
          <li><a href="/photos/" {% if '/photos' in page.url %}aria-current="page"{% endif %}>Photos</a></li>
        </ul>
      </nav>

      <div class="site-tools">
        {# Theme switcher #}
        <div class="theme-switcher" role="group" aria-label="Mode d'affichage">
          <button type="button" class="theme-btn" data-theme="light" aria-label="Mode clair" title="Clair">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6m0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z"/></svg>
          </button>
          <button type="button" class="theme-btn" data-theme="dark" aria-label="Mode sombre" title="Sombre">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278"/></svg>
          </button>
          <button type="button" class="theme-btn" data-theme="auto" aria-label="Mode automatique" title="Auto">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 15A7 7 0 1 0 8 1zm0 1A8 8 0 1 1 8 0a8 8 0 0 1 0 16"/></svg>
          </button>
        </div>

        {# Search button #}
        <button type="button" class="search-toggle" aria-label="Rechercher" aria-expanded="false" aria-controls="search-panel">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main" data-pagefind-body>
    {{ content | safe }}
  </main>

  {# Search panel #}
  <div id="search-panel" class="search-panel" hidden>
    <div class="search-panel__inner container">
      <div id="search-results" aria-live="polite"></div>
      <button type="button" class="search-panel__close" aria-label="Fermer la recherche">&times;</button>
    </div>
  </div>

  <script src="{{ '/pagefind/pagefind-ui.js' | url }}"></script>
  <script>
  (function(){
    // Mobile menu toggle
    var btn = document.querySelector('.menu-toggle');
    var nav = document.getElementById('nav-main');
    if (btn && nav) {
      btn.addEventListener('click', function() {
        var open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        nav.setAttribute('data-open', String(!open));
      });
    }

    // Theme switcher
    var root = document.documentElement;
    var themeBtns = document.querySelectorAll('.theme-btn');
    var stored = localStorage.getItem('theme') || 'auto';

    function applyTheme(t) {
      root.setAttribute('data-theme', t);
      if (t === 'auto') {
        root.style.colorScheme = '';
        root.removeAttribute('data-force-theme');
      } else {
        root.style.colorScheme = t;
        root.setAttribute('data-force-theme', t);
      }
      themeBtns.forEach(function(b) {
        b.setAttribute('aria-pressed', b.dataset.theme === t ? 'true' : 'false');
      });
      localStorage.setItem('theme', t);
    }

    themeBtns.forEach(function(b) {
      b.addEventListener('click', function() { applyTheme(b.dataset.theme); });
    });
    applyTheme(stored);

    // Search
    var searchBtn = document.querySelector('.search-toggle');
    var searchPanel = document.getElementById('search-panel');
    var searchClose = document.querySelector('.search-panel__close');
    var searchInit = false;

    function openSearch() {
      searchPanel.hidden = false;
      searchBtn.setAttribute('aria-expanded', 'true');
      if (!searchInit && typeof PagefindUI !== 'undefined') {
        new PagefindUI({
          element: '#search-results',
          showEmptyResults: false,
          resetStyles: false,
          snippetLength: 30,
          translations: { placeholder: 'Rechercher sur le site\u2026', results: 'r\u00e9sultat(s)', clear_search: 'Effacer', load_more: 'Charger plus' }
        });
        searchInit = true;
      }
      var input = searchPanel.querySelector('input');
      if (input) input.focus();
    }

    function closeSearch() {
      searchPanel.hidden = true;
      searchBtn.setAttribute('aria-expanded', 'false');
      searchBtn.focus();
    }

    if (searchBtn && searchPanel) {
      searchBtn.addEventListener('click', openSearch);
      searchClose.addEventListener('click', closeSearch);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !searchPanel.hidden) closeSearch();
      });
      // Skip link: intercept click on #search-panel anchor
      var skipSearch = document.querySelector('a.skip-link[href="#search-panel"]');
      if (skipSearch) {
        skipSearch.addEventListener('click', function(e) { e.preventDefault(); openSearch(); });
      }
      // Label the Pagefind input for accessibility (NC9)
      var observer = new MutationObserver(function() {
        var input = searchPanel.querySelector('input');
        if (input && !input.getAttribute('aria-label')) {
          input.setAttribute('aria-label', 'Rechercher sur le site');
          observer.disconnect();
        }
      });
      observer.observe(searchPanel, { childList: true, subtree: true });
    }
  })();
  </script>

  <footer id="footer" class="site-footer">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__title">Oxymore</p>
        <p>Le site personnel de Jean-Philippe Simonnet, expert accessibilité numérique depuis 2011. Ici, mes lectures, interventions et réflexions autour d'un numérique plus inclusif.</p>
      </div>
      <nav class="site-footer__col" aria-label="Navigation du pied de page">
        <p class="site-footer__col-title">Naviguer</p>
        <ul>
          <li><a href="/qui-suis-je/">À propos</a></li>
          <li><a href="/a-la-une/">À la une</a></li>
          <li><a href="/lectures/">Lectures</a></li>
          <li><a href="/interventions/">Interventions</a></li>
          <li><a href="/photos/">Photos</a></li>
        </ul>
      </nav>
      <nav class="site-footer__col" aria-label="Informations légales">
        <p class="site-footer__col-title">Informations</p>
        <ul>
          <li><a href="/accessibilite/">Accessibilité</a></li>
          <li><a href="/mentions/">Mentions légales</a></li>
          <li><a href="/plan/">Plan du site</a></li>
        </ul>
      </nav>
    </div>
    <div class="site-footer__bottom">
      <p><a rel="license" href="https://creativecommons.org/licenses/by-sa/3.0/fr/">CC BY-SA 3.0 FR - {% year %}</a></p>
      <p><a href="/feed.xml">Flux <abbr title="Really Simple Syndication" lang="en">RSS</abbr></a></p>
    </div>
  </footer>
</body>
</html>
