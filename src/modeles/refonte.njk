---
permalink: false
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Oxymore (refonte)</title>
  <meta name="description" content="{{ description or 'Jean-Philippe Simonnet — expert accessibilité numérique.' }}">
  <meta name="robots" content="noindex, nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/refonte.css">
  <link rel="icon" href="/favicon.ico">
</head>
<body>
  <a class="skip-link" href="#main">Aller au contenu</a>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-logo" href="/refonte/" aria-label="Oxymore — accueil">
        <svg class="logo_oxymore" role="img" aria-label="Oxymore — un silence assourdissant"
             viewBox="0 0 598 220" xmlns="http://www.w3.org/2000/svg"
             style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;">
          <g transform="matrix(1,0,0,1,-17,10)">
            <g transform="matrix(1,0,0,1,-136.127,-86.0034)">
              <path class="logo-swoosh" d="M191,213.128C191,213.128 337.945,158.83 430.99,213C542.829,278.112 681.235,212 681.235,212C681.235,212 574.259,317.376 423,247.251C333.393,205.709 191,213.128 191,213.128Z"/>
            </g>
            <g transform="matrix(1,0,0,1,12,135)">
              <text class="logo-title" x="0" y="0"
                    style="font-family:'Playfair Display','Didot',serif;font-weight:700;font-size:136.813px;">Oxymore</text>
            </g>
            <g transform="matrix(1.35,0,0,1.30,115,50)">
              <text class="logo-subtitle" x="0" y="0"
                    style="font-family:'Playfair Display','Didot',serif;font-weight:400;font-size:34px;font-style:italic;">un silence assourdissant</text>
            </g>
          </g>
        </svg>
      </a>

      <button class="menu-toggle" aria-expanded="false" aria-controls="nav-main" aria-label="Menu">
        <svg class="icon-open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="icon-close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <nav class="site-nav" id="nav-main" aria-label="Navigation principale">
        <ul>
          <li><a href="/refonte/" {% if page.url == '/refonte/' %}aria-current="page"{% endif %}>Accueil</a></li>
          <li><a href="/refonte/qui-suis-je/" {% if page.url == '/refonte/qui-suis-je/' %}aria-current="page"{% endif %}>À propos</a></li>
          <li><a href="/refonte/a-la-une/" {% if '/refonte/a-la-une' in page.url %}aria-current="page"{% endif %}>À la une</a></li>
          <li><a href="/refonte/lectures/" {% if '/refonte/lectures' in page.url %}aria-current="page"{% endif %}>Lectures</a></li>
          <li><a href="/refonte/interventions/" {% if page.url == '/refonte/interventions/' %}aria-current="page"{% endif %}>Interventions</a></li>
          <li><a href="/refonte/photos/" {% if '/refonte/photos' in page.url %}aria-current="page"{% endif %}>Photos</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <script>
  (function(){
    var btn = document.querySelector('.menu-toggle');
    var nav = document.getElementById('nav-main');
    if (!btn || !nav) return;
    btn.addEventListener('click', function() {
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      nav.setAttribute('data-open', String(!open));
    });
  })();
  </script>

  <footer class="site-footer">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__title">Oxymore</p>
        <p>Le site personnel de Jean-Philippe Simonnet, expert accessibilité numérique depuis 2011. Ici, mes lectures, interventions et réflexions autour d'un numérique plus inclusif.</p>
      </div>
      <nav class="site-footer__col" aria-label="Navigation du pied de page">
        <p class="site-footer__col-title">Naviguer</p>
        <ul>
          <li><a href="/refonte/qui-suis-je/">À propos</a></li>
          <li><a href="/refonte/a-la-une/">À la une</a></li>
          <li><a href="/refonte/lectures/">Lectures</a></li>
          <li><a href="/refonte/interventions/">Interventions</a></li>
          <li><a href="/refonte/photos/">Photos</a></li>
        </ul>
      </nav>
      <nav class="site-footer__col" aria-label="Informations légales">
        <p class="site-footer__col-title">Informations</p>
        <ul>
          <li><a href="/refonte/accessibilite/">Accessibilité</a></li>
          <li><a href="/refonte/mentions/">Mentions légales</a></li>
          <li><a href="/refonte/plan/">Plan du site</a></li>
          <li><a href="/">← Site actuel</a></li>
        </ul>
      </nav>
    </div>
    <div class="site-footer__bottom">
      <p>© {% year %} Jean-Philippe Simonnet — Prototype de refonte</p>
      <p>Un silence assourdissant</p>
    </div>
  </footer>
</body>
</html>
