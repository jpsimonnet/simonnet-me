<!doctype html>
<html lang="fr" data-bs-theme="light">
    <head>
      <title>{{ site.title }} - {{ title or meta.title }}</title>
       {% include "meta.njk" %}
      </head>
<body>
  <div class="container">


      {% include "header.njk" %}


  <main id="main">

<div class="container py-4"> 

<section aria-labelledby="titre-actualite" class="actualite-a-la-une my-5">
  <h2 id="titre-actualite" class="h4 mb-3">À la une</h2>

  {% if actualite and actualite.length > 0 %}
    <ul class="list-unstyled">
      {% for item in actualite %}
        <li class="mb-4">
          {% if item.image %}
            <img src="{{ item.image }}" alt="{{ item.title }}" class="img-fluid mb-2" style="max-width: 400px;" />
          {% endif %}
          <h3 class="h5">
            <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">
              {{ item.title }}
            </a>
          </h3>
          <p class="text-muted">Publié le {{ item.created | formatDateFr }}</p>
          {% if item.summary %}
            <p>{{ item.summary }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>Aucune actualité à la une pour le moment.</p>
  {% endif %}
</section>



</div>

    <div class="container py-4">
 
      {{ content | safe }}

  </div>

  </main>


  {% include "footer.njk" %}

  </div>

</body>
</html> 