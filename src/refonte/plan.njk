permalink: /refonte/plan/
---

<section class="hero">
  <div class="container">
    <nav aria-label="Fil d'Ariane">
      <ol class="breadcrumb">
        <li><a href="/refonte/">Accueil</a></li>
        <li aria-current="page">Plan du site</li>
      </ol>
    </nav>

    <p class="kicker">Navigation</p>
    <h1>Plan du <em>site</em></h1>
    <p class="lede">L'ensemble des pages et contenus du site.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="prose">
      <h2>Pages principales</h2>
      <ul>
        <li><a href="/refonte/">Accueil</a></li>
        <li><a href="/refonte/qui-suis-je/">À propos</a></li>
        <li><a href="/refonte/a-la-une/">À la une</a></li>
        <li><a href="/refonte/lectures/">Lectures</a></li>
        <li><a href="/refonte/interventions/">Interventions</a></li>
        <li><a href="/refonte/photos/">Photos</a></li>
      </ul>

      <h2>Lectures</h2>
      <ul>
        {% for livre in collections.livresTries %}
        <li>
          <a href="/refonte/livre/{{ livre.id }}/">{{ livre.Nom | e }}</a>
          {% if livre.Auteur %}— <em>{{ livre.Auteur }}</em>{% endif %}
        </li>
        {% endfor %}
      </ul>

      <h2>Interventions</h2>
      <ul>
        {% for post in collections.interventions | reverse %}
        <li>
          <a href="{{ post.url }}">{{ post.data.title | e }}</a>
        </li>
        {% endfor %}
      </ul>

      <h2>Galeries photos</h2>
      <ul>
        {% for galerie in galeries %}
        <li><a href="/refonte/photos/{{ galerie.slug }}/">{{ galerie.title | e }}</a></li>
        {% endfor %}
      </ul>

      <h2>Informations</h2>
      <ul>
        <li><a href="/refonte/accessibilite/">Accessibilité</a></li>
        <li><a href="/refonte/mentions/">Mentions légales</a></li>
      </ul>
    </div>
  </div>
</section>
