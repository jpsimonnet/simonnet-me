---
layout: refonte
title: Plan du site
permalink: /plan/
---

<section class="hero">
  <div class="container">
    <nav aria-label="Fil d'Ariane">
      <ol class="breadcrumb">
        <li><a href="/">Accueil</a></li>
        <li aria-current="page">Plan du site</li>
      </ol>
    </nav>

    <p class="kicker">Navigation</p>
    <h1>Plan du <em>site</em></h1>
    <p class="lede">L'ensemble des pages et contenus du site.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="prose">
      <h2>Pages principales</h2>
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/qui-suis-je/">À propos</a></li>
        <li><a href="/a-la-une/">À la une</a></li>
        <li><a href="/outils/">Outils</a></li>
        <li><a href="/lectures/">Lectures</a></li>
        <li><a href="/interventions/">Interventions</a></li>
        <li><a href="/photos/">Photos</a></li>
      </ul>

      <h2>À la une</h2>
      <ul>
        {% for item in aLaUne %}
        <li>
          <a href="/actualite/{{ item.slug or (item.title | slugify) }}/">{{ item.title | e }}</a>
        </li>
        {% endfor %}
      </ul>

      {% if outils and outils.length > 0 %}
      <h2>Outils</h2>
      <ul>
        {% for item in outils %}
        <li>
          <a href="/actualite/{{ item.slug or (item.title | slugify) }}/">{{ item.title | e }}</a>
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      <h2>Lectures</h2>
      <ul>
        {% for livre in collections.livresTries %}
        <li>
          <a href="/livre/{{ livre.id }}/">{{ livre.Nom | e }}</a>
          {% if livre.Auteur %}— <em>{{ livre.Auteur }}</em>{% endif %}
        </li>
        {% endfor %}
      </ul>

      <h2>Interventions</h2>
      <ul>
        {% for post in collections.interventions | reverse %}
        <li>
          <a href="/intervention/{{ post.fileSlug }}/">{{ post.data.title | e }}</a>
        </li>
        {% endfor %}
      </ul>

      <h2>Galeries photos</h2>
      <ul>
        {% for galerie in galeries %}
        <li><a href="/photos/{{ galerie.slug }}/">{{ galerie.title | e }}</a></li>
        {% endfor %}
      </ul>

      <h2>Informations</h2>
      <ul>
        <li><a href="/accessibilite/">Accessibilité</a></li>
        <li><a href="/mentions/">Mentions légales</a></li>
      </ul>
    </div>
  </div>
</section>
