---
layout: refonte
title: Outils
pagination:
  data: outils
  size: 9
  alias: outilsPage
  generatePageOnEmptyData: true
permalink: "outils/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber }}/{% endif %}index.html"
---

<section class="hero">
  <div class="container">
    <nav aria-label="Fil d'Ariane">
      <ol class="breadcrumb">
        <li><a href="/">Accueil</a></li>
        <li aria-current="page">Outils</li>
      </ol>
    </nav>

    <p class="kicker">Ma boîte à outils</p>
    <h1>Des <em>outils</em></h1>
    <p class="lede">
      Une sélection d'outils pour l'accessibilité numérique, l'intelligence artificielle et le web,
      repérés au fil de ma veille. Elle est aussi disponible sur
      <a href="https://oxymore.notion.site/" rel="external noopener">Notion</a>.
    </p>
  </div>
</section>

<section>
  <div class="container">
    {% if outilsPage and outilsPage.length > 0 %}
    <div class="grid-editorial">
      {% for item in outilsPage %}
      <article class="card-editorial">
        {% if item.image %}
        <div class="card-editorial__image">
          <img src="{{ item.image }}" alt="Illustration de {{ item.title | e }}" loading="lazy">
        </div>
        {% endif %}
        <p class="card-editorial__meta">
          <time datetime="{{ item.created }}">{{ item.created | formatDateFr }}</time>
        </p>
        <h2 class="card-editorial__title">
          <a href="/actualite/{{ item.slug or (item.title | slugify) }}/">
            {{ item.title | e }}
          </a>
        </h2>
        {% if item.summary %}
        <p>{{ item.summary | truncate(160) }}</p>
        {% endif %}
      </article>
      {% endfor %}
    </div>

    {% if pagination.pages.length > 1 %}
    <nav aria-label="Pagination">
      <ul class="pagination">
        {% if pagination.href.previous %}
          <li><a href="{{ pagination.href.previous }}" rel="prev">← Précédente</a></li>
        {% else %}
          <li><span class="disabled">← Précédente</span></li>
        {% endif %}

        {% for pageNumber in pagination.pages %}
          {% set pageIndex = loop.index0 %}
          {% if pageIndex == pagination.pageNumber %}
            <li><span aria-current="page">{{ pageIndex + 1 }}</span></li>
          {% else %}
            <li><a href="{{ pagination.hrefs[pageIndex] }}">{{ pageIndex + 1 }}</a></li>
          {% endif %}
        {% endfor %}

        {% if pagination.href.next %}
          <li><a href="{{ pagination.href.next }}" rel="next">Suivante →</a></li>
        {% else %}
          <li><span class="disabled">Suivante →</span></li>
        {% endif %}
      </ul>
    </nav>
    {% endif %}
    {% else %}
    <p>Aucun outil pour le moment.</p>
    {% endif %}
  </div>
</section>
